generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") //fake env only for CI
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique
  firstname             String?
  lastname              String?
  password              String
  miage                 String?
  ville                 String?
  hotelRoom             String
  hotelFloor            String?
  doorCode              String?
  isAdmin               Boolean                @default(false)
  createdAt             DateTime               @default(now())
  messageReads          MessageRead[]
  activityRegistrations ActivityRegistration[]
}

model Message {
  id        Int           @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime      @default(now())
  reads     MessageRead[]
}

model MessageRead {
  userId    Int
  messageId Int
  readAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
}

model Setting {
  key   String @id
  value String
}

model ActivityGroup {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  isOpen      Boolean    @default(false)
  maxPerUser  Int        @default(1)
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  activities  Activity[]
}

model Activity {
  id            Int                    @id @default(autoincrement())
  title         String
  description   String?
  maxSeats      Int?
  order         Int                    @default(0)
  groupId       Int
  group         ActivityGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  speakers      ActivitySpeaker[]
  registrations ActivityRegistration[]
}

model ActivitySpeaker {
  id          Int      @id @default(autoincrement())
  name        String
  role        String?
  company     String?
  linkedinUrl String?
  activityId  Int
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model ActivityRegistration {
  userId     Int
  activityId Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([userId, activityId])
}
