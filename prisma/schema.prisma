generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  firstname    String?
  lastname     String?
  password     String
  miage        String?
  ville        String?
  hotelRoom    String
  hotelFloor   String?
  doorCode     String?
  isAdmin      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  messageReads MessageRead[]
  roundTableRegistrations RoundTableRegistration[]
}

model Message {
  id        Int           @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime      @default(now())
  reads     MessageRead[]
}

model MessageRead {
  userId    Int
  messageId Int
  readAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
}

model Setting {
  key   String @id
  value String
}

model RoundTable {
  id            Int                      @id @default(autoincrement())
  title         String
  description   String?
  maxSeats      Int?
  order         Int                      @default(0)
  speakers      RoundTableSpeaker[]
  registrations RoundTableRegistration[]
}

model RoundTableSpeaker {
  id           Int        @id @default(autoincrement())
  name         String
  role         String?
  company      String?
  linkedinUrl  String?
  roundTableId Int
  roundTable   RoundTable @relation(fields: [roundTableId], references: [id], onDelete: Cascade)
}

model RoundTableRegistration {
  userId       Int
  roundTableId Int
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundTable   RoundTable @relation(fields: [roundTableId], references: [id], onDelete: Cascade)

  @@id([userId, roundTableId])
}
